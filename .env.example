DB_URL=jdbc:postgresql://your-db-host:5432/aideep
DB_USERNAME=your_username
DB_PASSWORD=your_password
REDIS_HOST=your-redis-host
JWT_SECRET=your_secret

# Recall.ai 봇 시간 상한(초). 비우거나 0 이하면 해당 상한을 Recall에 보내지 않는다.
# RECALL_RECORDING_TIMEOUT_SECONDS: 녹화 시작 이후 회의 길이 상한
# RECALL_WAITING_TIMEOUT_SECONDS: 녹화 전 대기실/참가자 없음 상태 상한
RECALL_RECORDING_TIMEOUT_SECONDS=1800
RECALL_WAITING_TIMEOUT_SECONDS=600

# Existing Datadog Agent reachable from the app container
DD_AGENT_HOST=your-datadog-agent-host
DD_TRACE_AGENT_PORT=8126
DD_DOGSTATSD_PORT=8125
DD_SERVICE=aideep
DD_ENV=prod
DD_VERSION=0.0.1-SNAPSHOT
DD_TRACE_ENABLED=true
DD_RUNTIME_METRICS_ENABLED=true
DD_METRICS_ENABLED=true
